+DEFAULT_SCHEMA = os.environ.get("VB6GRAPH_DEFAULT_SCHEMA", "dbo")
+
+
+def qualify_db_object(name: str) -> str:
+    """`[srv].[db].[schema].[obj]` -> `schema.obj`, keeping case. Without a schema the default one (dbo) is
+    assumed, as SQL Server does; temp tables (#x, @x) keep no schema. `stg.Polizas` and `dbo.Polizas` stay apart."""
+    parts = re.sub(r'[\[\]"`]', "", name.strip()).split(".")
+    obj = parts[-1].strip()
+    if obj.startswith(("#", "@")):
+        return obj
+    schema = parts[-2].strip() if len(parts) >= 2 and parts[-2].strip() else DEFAULT_SCHEMA
+    return f"{schema}.{obj}"
+
+
 def table_id(name: str) -> str:
-    """Global table id shared by VB6 and SSIS: strips brackets, quotes and schema/db prefixes."""
-    n = re.sub(r'[\[\]"`]', "", name.strip())
-    n = n.split(".")[-1]
-    return f"table:{n.lower()}"
+    """Global table id shared by VB6 and SSIS: `table:schema.table` (server/db prefixes dropped)."""
+    return f"table:{qualify_db_object(name).lower()}"
+
+
+def db_proc_id(name: str) -> str:
+    """Global stored procedure id shared by VB6 and SSIS: `db_proc:schema.proc`."""
+    return f"db_proc:{qualify_db_object(name).lower()}"
 
 
