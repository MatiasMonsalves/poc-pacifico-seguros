{
    "name": "PL_CargaPolizas",
    "properties": {
        "description": "Convertido desde el paquete SSIS CargaPolizas con tools/ssis2adf",
        "activities": [
            {
                "name": "Truncar Staging",
                "type": "Script",
                "linkedServiceName": {
                    "referenceName": "LS_SQL_OLTP",
                    "type": "LinkedServiceReference"
                },
                "policy": {
                    "timeout": "0.02:00:00",
                    "retry": 0
                },
                "typeProperties": {
                    "scripts": [
                        {
                            "type": "NonQuery",
                            "text": "TRUNCATE TABLE stg.Polizas"
                        }
                    ]
                }
            },
            {
                "name": "Cargar CSV a Staging",
                "type": "Copy",
                "policy": {
                    "timeout": "0.02:00:00",
                    "retry": 0
                },
                "outputs": [
                    {
                        "referenceName": "DS_OLTP_stg_Polizas",
                        "type": "DatasetReference"
                    }
                ],
                "inputs": [
                    {
                        "referenceName": "DS_ArchivoPolizas",
                        "type": "DatasetReference",
                        "parameters": {
                            "fileName": {
                                "value": "@pipeline().parameters.Archivo",
                                "type": "Expression"
                            }
                        }
                    }
                ],
                "typeProperties": {
                    "source": {
                        "type": "DelimitedTextSource",
                        "storeSettings": {
                            "type": "AzureBlobStorageReadSettings"
                        },
                        "formatSettings": {
                            "type": "DelimitedTextReadSettings"
                        }
                    },
                    "sink": {
                        "type": "AzureSqlSink",
                        "writeBehavior": "insert"
                    },
                    "translator": {
                        "type": "TabularTranslator",
                        "mappings": [
                            {
                                "source": {
                                    "name": "NumPoliza"
                                },
                                "sink": {
                                    "name": "NumPoliza"
                                }
                            },
                            {
                                "source": {
                                    "name": "Rut"
                                },
                                "sink": {
                                    "name": "Rut"
                                }
                            },
                            {
                                "source": {
                                    "name": "TipoSeguro"
                                },
                                "sink": {
                                    "name": "TipoSeguro"
                                }
                            },
                            {
                                "source": {
                                    "name": "SumaAsegurada"
                                },
                                "sink": {
                                    "name": "SumaAsegurada"
                                }
                            },
                            {
                                "source": {
                                    "name": "PrimaBase"
                                },
                                "sink": {
                                    "name": "PrimaBase"
                                }
                            },
                            {
                                "source": {
                                    "name": "Siniestros"
                                },
                                "sink": {
                                    "name": "Siniestros"
                                }
                            },
                            {
                                "source": {
                                    "name": "FechaInicio"
                                },
                                "sink": {
                                    "name": "FechaInicio"
                                }
                            },
                            {
                                "source": {
                                    "name": "FechaTermino"
                                },
                                "sink": {
                                    "name": "FechaTermino"
                                }
                            }
                        ]
                    }
                },
                "dependsOn": [
                    {
                        "activity": "Truncar Staging",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ]
            },
            {
                "name": "Consolidar",
                "type": "SqlServerStoredProcedure",
                "linkedServiceName": {
                    "referenceName": "LS_SQL_OLTP",
                    "type": "LinkedServiceReference"
                },
                "policy": {
                    "timeout": "0.02:00:00",
                    "retry": 0
                },
                "typeProperties": {
                    "storedProcedureName": "[dbo].[usp_ConsolidarPolizas]",
                    "storedProcedureParameters": {
                        "FechaProceso": {
                            "value": {
                                "value": "@if(empty(pipeline().parameters.FechaProceso), convertFromUtc(utcNow(), 'Pacific SA Standard Time', 'yyyy-MM-dd'), pipeline().parameters.FechaProceso)",
                                "type": "Expression"
                            },
                            "type": "DateTime"
                        }
                    }
                },
                "dependsOn": [
                    {
                        "activity": "Cargar CSV a Staging",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ]
            },
            {
                "name": "Registrar Error",
                "type": "Script",
                "linkedServiceName": {
                    "referenceName": "LS_SQL_OLTP",
                    "type": "LinkedServiceReference"
                },
                "policy": {
                    "timeout": "0.02:00:00",
                    "retry": 0
                },
                "typeProperties": {
                    "scripts": [
                        {
                            "type": "NonQuery",
                            "text": "INSERT INTO log.ErroresETL (Paquete, Fecha) VALUES ('CargaPolizas', GETDATE())"
                        }
                    ]
                },
                "dependsOn": [
                    {
                        "activity": "Consolidar",
                        "dependencyConditions": [
                            "Failed"
                        ]
                    }
                ]
            },
            {
                "name": "Fallar tras Registrar Error",
                "type": "Fail",
                "dependsOn": [
                    {
                        "activity": "Registrar Error",
                        "dependencyConditions": [
                            "Completed"
                        ]
                    }
                ],
                "typeProperties": {
                    "message": {
                        "value": "@concat('Consolidar falló: ', activity('Consolidar').error.message)",
                        "type": "Expression"
                    },
                    "errorCode": "500"
                }
            }
        ],
        "parameters": {
            "Archivo": {
                "type": "string",
                "defaultValue": "polizas.csv"
            },
            "FechaProceso": {
                "type": "string",
                "defaultValue": ""
            }
        },
        "annotations": [
            "ssis2adf"
        ]
    }
}
